# Gostly environment template. On a fresh install, run ./setup.sh: it copies
# this file to .env, fills the generated secrets, asks for the REQUIRED values
# below and starts the stack. Keep .env private and keep it across upgrades:
# git pull never changes it. README.md describes every setting.

# ── Admin ────────────────────────────────────────────────────────────────────
# The first dashboard admin, created at the first start with both values set
# and no users yet. The sign-in page at http://localhost:3000 has no sign-up.
# REQUIRED: the email address you sign in with (./setup.sh asks for it).
GOSTLY_ADMIN_EMAIL=
# REQUIRED: 12 to 72 characters (./setup.sh asks, or generates one and prints it
# once). Wrap a hand-set value in single quotes if it has $, # or spaces.
GOSTLY_ADMIN_PASSWORD=
# Optional: the name the dashboard shows for this account.
GOSTLY_ADMIN_FULL_NAME=
# Sign-in methods: keep password (saml and oidc need docker-compose.full.yaml).
GOSTLY_AUTH_MODE=password

# ── Licence and tenant ───────────────────────────────────────────────────────
# FRESH-INSTALL TEMPLATE: do not replace an existing persisted deployment's
# .env with this file. Preserve its database passwords and GOSTLY_TENANT_ID.
# If it has no tenant pin yet, do NOT adopt the organization UUID below:
# capture and pin its currently resolved tenant under the old key before any
# key rotation. See docs/operations/license-key-rotation.md in the Gostly
# distribution.

# Your Gostly license key — get yours at https://gostly.ai/dashboard
# REQUIRED: ./setup.sh asks for it. The dashboard shows the full key once, when
# the key is created; if you no longer have it, rotate it there.
GOSTLY_LICENSE_KEY=

# Stable tenant identity for this platform organization. Fresh installs must
# preserve this value across license-key rotation; it is not a secret. Existing
# unpinned deployments must retain their old resolved tenant as warned above.
# Written by ./setup.sh from your licence key: gostly.ai returns the key's
# Workspace ID when it checks the key. Keep it once it is set.
GOSTLY_TENANT_ID=

# ── Upstream ─────────────────────────────────────────────────────────────────
# The upstream service Gostly proxies traffic to and from. A fresh install
# starts on the bundled demo upstream, so you can record and replay before
# wiring a service of your own. These two lines go together: the profile
# starts the demo container and BACKEND_URL sends the proxy to it. The demo
# answers only under /gostly-demo/, so demo requests, captures and mocks are
# easy to tell apart from your own traffic. Try it once the stack is up:
#   curl http://localhost:8080/gostly-demo/get
# To keep it under its own name in the local dashboard, add a service with
# upstream http://gostly-demo-upstream:8080 and path rule /gostly-demo.
# To proxy your own service, set BACKEND_URL to it (for example
# http://your-service:3000), delete the COMPOSE_PROFILES line, then run
#   docker compose up -d && docker compose rm -sf gostly-demo-upstream
# Never keep the demo BACKEND_URL without COMPOSE_PROFILES=demo: the demo
# would not start and the proxy would answer 502 Bad Gateway.
COMPOSE_PROFILES=demo
BACKEND_URL=http://gostly-demo-upstream:8080

# ── Stack ────────────────────────────────────────────────────────────────────
# docker compose uses docker-compose.yaml (Lite) by default. ./setup.sh asks once
# and writes this line; set it to docker-compose.full.yaml for Full (with the AI
# services). Every docker compose command in this directory then uses it.
# COMPOSE_FILE=docker-compose.full.yaml

# ── Ports ────────────────────────────────────────────────────────────────────
# Host ports of the dashboard and the proxy; unset keeps these defaults. If you
# move the dashboard, set ALLOWED_ORIGINS and MCP_ALLOWED_ORIGINS to its new
# address, for example http://localhost:3001. The API stays on 127.0.0.1:8000.
# GOSTLY_WEB_PORT=3000
# GOSTLY_PROXY_PORT=8080

# ── Other settings ───────────────────────────────────────────────────────────
# Shared Activities projection. Required order: upgrade PostgreSQL to sole
# head 0033, deploy and drain the complete new API fleet with this false, run
# the Activities readiness checks, then enable it.
ACTIVITIES_V2_ENABLED=false

# Control-plane API key, written by ./setup.sh. Send it as the X-API-Key
# header on API calls to port 8000 (curl, CI, scripts); admins can also copy it
# from Settings in the dashboard. ghost-web mirrors it into the data volume,
# where ghost-proxy reads it. Keep it private and preserve it on upgrade.
# While this line is set the key is pinned: change it here and recreate
# ghost-web and ghost-proxy; the dashboard cannot rotate it. Generate a new
# value in the same gsk_svc_ form (command at gostly.ai/docs/install). Delete
# the line to hand a gsk_svc_ key to the dashboard, which can then rotate it;
# for any other value, ghost-migrate stops and prints how to replace the key
# file.
GHOST_API_KEY=

# ── Time Chamber ─────────────────────────────────────────────────────────────
# Deterministic episodes: snapshot, reset and a virtual clock on ghost-proxy's
# /ghost/* routes (port 8080, same X-API-Key header). On by default. Set 0 to
# turn them off, then recreate ghost-proxy.
GOSTLY_EPISODES=1

# Optional fixed chaos seed, an unsigned 64-bit integer. Set it before taking a
# snapshot while chaos can apply in MOCK; it also seeds chaos outside episodes.
# CHAOS_SEED=

# Time Chamber API mutations: snapshot, fork and reset through ghost-web's REST
# routes (POST /v1/time-chamber/...) and the keyed MCP episode tools. Off by
# default; while false those calls are refused. The /ghost/* routes above do
# not need it. Set true only once ghost-web runs the upgraded image (pull and
# recreate it first with this still false), then recreate ghost-web.
GOSTLY_SHARED_EPISODE_MUTATIONS_ENABLED=false

# ── Inference ────────────────────────────────────────────────────────────────
# These tune the AI services of docker-compose.full.yaml; Lite runs none.
# /generate routes through the ghost-llamacpp sidecar by default (the
# production path, ~9× faster than in-process PyTorch). Set true ONLY to
# ALSO load the v2 PyTorch base in-process as a fallback (~2 GB extra RAM).
ENABLE_GENERATION=false

# RAG-based response matching over recorded mocks
ENABLE_RAG=true

# CPU thread count for inference (set to ~75% of allocated cores)
INFERENCE_NUM_THREADS=4

# Bounded training lifecycle callback delivery. Tune the request timeout from
# measured ghost-web /notify p99 under database-lock load; keep total >= request.
# Invalid values fail inference startup. Bounds: request 0.05-30s, total
# 0.1-120s, transport threads 1-64.
FINETUNE_CALLBACK_REQUEST_TIMEOUT_S=2
FINETUNE_CALLBACK_TOTAL_DEADLINE_S=10
FINETUNE_CALLBACK_TRANSPORT_THREAD_LIMIT=8

# Minimum confidence required to serve a generated response
AI_CONFIDENCE_THRESHOLD=0.70

# Sidecar endpoint — defaults to the in-network ghost-llamacpp container.
# Override only if running llama-server natively on the host (e.g. Mac
# Metal: http://host.docker.internal:6550).
# LLAMACPP_ENDPOINT=http://ghost-llamacpp:8080

# ── MCP browser boundary (Team feature) ──────────────────────────────────────
# The API itself defaults the MCP Origin allowlist to empty (fail closed).
# Pro and Team share this browser boundary in both variants; these values are inert while
# the MCP feature is unlicensed on Pro and support an in-place Team upgrade.
# This installer publishes its dashboard at http://localhost:3000, so the
# shipped topology opts in that exact browser origin. Change it if you expose
# the dashboard at another URL; wildcards and regexes are rejected.
MCP_ALLOWED_ORIGINS=http://localhost:3000

# Raw MCP POST ceiling, enforced before UTF-8 or JSON decoding (1 KiB-1 MiB).
MCP_MAX_REQUEST_BODY_BYTES=1048576

# ── Database ─────────────────────────────────────────────────────────────────
# The bundled database bootstraps three privilege tiers. Migrations use the
# owner role; normal API requests use the FORCE-RLS gostly_app role; explicitly
# cross-tenant maintenance uses the constrained gostly_service role.
POSTGRES_USER=ghost
# FIRST INSTALL ONLY: ./setup.sh fills these once and never replaces them.
# Preserve all existing database passwords when upgrading persisted storage.
POSTGRES_PASSWORD=
POSTGRES_DB=ghost

# Fresh platform installs use independent runtime-role secrets so the serving
# process never receives the schema-owner password. Preserve all three values
# on upgrade. Changing them later does not rotate PostgreSQL: coordinate ALTER
# ROLE, these values/DSNs, and the web restart as one operator action.
GOSTLY_APP_DB_PASSWORD=
GOSTLY_SERVICE_DB_PASSWORD=

# External PostgreSQL is an advanced topology. Runtime URLs must be direct or
# session-pooled and preserve PostgreSQL startup parameters. Transaction-mode
# pooling is unsupported. The migration URL must be direct and use a role with
# schema ownership plus role-administration privileges. Use a dedicated Gostly
# database: gostly_app/gostly_service are cluster-global role names. Passwords
# containing URI-reserved characters must be percent-encoded in explicit DSNs.
# Before the first migration, raw GOSTLY_APP_DB_PASSWORD and
# GOSTLY_SERVICE_DB_PASSWORD values must match the decoded explicit DSN secrets.
# DATABASE_URL=postgresql://gostly_app:app-password@db.example:5432/ghost
# SERVICE_DATABASE_URL=postgresql://gostly_service:service-password@db.example:5432/ghost
# MIGRATIONS_DATABASE_URL=postgresql://schema-owner:owner-password@db.example:5432/ghost
